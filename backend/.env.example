# Copy to .env for local runs (never commit .env). Production sets these in the host's settings.
PORT=8080
DATABASE_URL=postgres://postgres@127.0.0.1:5432/queaura
# AI games a new account starts with (spec §8).
FREE_AI_GAMES=2
# Generated questions in one AI game, regenerations included (spec §8).
QUESTIONS_PER_AI_GAME=50

# Who writes the questions (spec §8): anthropic | openai | deepseek | moonshot, and the model.
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-5-5
# Claude only: low | medium | high.
AI_EFFORT=medium
# Only the active provider's key is needed. Keep keys out of git; production sets them as secrets.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
# The active model's list prices, US dollars per million tokens, for the cost records.
AI_PRICE_INPUT=2
AI_PRICE_OUTPUT=10

# Sign-in (Clerk). The JWT public key (Clerk dashboard → API keys → JWT public key, PEM) checks
# tokens with no network call; on one line, write its line breaks as \n. Or set the secret key.
CLERK_JWT_KEY=
CLERK_SECRET_KEY=
# Guard against runaway use: generation requests per host. Failed requests count too.
GENERATE_PER_MINUTE=6
GENERATE_PER_DAY=100
