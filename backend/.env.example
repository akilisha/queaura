# Copy to .env for local runs (never commit .env). Production sets these in the host's settings.
PORT=8080
DATABASE_URL=postgres://postgres@127.0.0.1:5432/queaura
# This environment's schema: dev and prod share one database, each in its own schema.
DATABASE_SCHEMA=queaura_dev
# AI games a new account starts with (spec §8).
FREE_AI_GAMES=2
# Generated questions in one AI game, regenerations included (spec §8).
QUESTIONS_PER_AI_GAME=50

# Who writes the questions (spec §8): anthropic | openai | deepseek | moonshot, and the model.
AI_PROVIDER=anthropic
AI_MODEL=claude-haiku-5-5
# Claude only: low | medium | high.
AI_EFFORT=medium
# Only the active provider's key is needed. Keep keys out of git; production sets them as secrets.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
# The active model's list prices, US dollars per million tokens, for the cost records.
AI_PRICE_INPUT=0.1
AI_PRICE_OUTPUT=0.5
# Tried in order when the main provider fails: provider:model:input price:output price.
AI_FALLBACKS=openai:gpt-6.1-sol:2:10,deepseek:deepseek-flash:0.3:1.2

# Sign-in (Clerk). The JWT public key (Clerk dashboard → API keys → JWT public key, PEM) checks
# tokens with no network call; on one line, write its line breaks as \n. Or set the secret key.
CLERK_JWT_KEY=
CLERK_SECRET_KEY=
# Guard against runaway use: generation requests per host. Failed requests count too.
GENERATE_PER_MINUTE=12
GENERATE_PER_DAY=100

# Google Play (spec §8). Packs: product id:AI games; prices are set in the Play Console.
GOOGLE_PLAY_PACKAGE=com.queaura.host
PACKS=ai_games_1:1,ai_games_5:5,ai_games_10:10
# The service account's JSON key (one line), so purchases can be confirmed with Google.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Purchase notifications (Pub/Sub push to /google/rtdn): the endpoint URL and the pushing service account.
RTDN_AUDIENCE=
RTDN_SERVICE_ACCOUNT=
