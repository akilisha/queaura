# Copy to .env for local runs (never commit .env). Production sets these in the host's settings.
PORT=8080
DATABASE_URL=postgres://postgres@127.0.0.1:5432/queaura
# AI games a new account starts with (spec §8).
FREE_AI_GAMES=2
# Generated questions in one AI game, regenerations included (spec §8).
QUESTIONS_PER_AI_GAME=50
